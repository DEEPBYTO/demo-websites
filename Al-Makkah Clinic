  [],
  ["Patients", cache.patients.length],
  ["Appointments", cache.appointments.length],
  ["Prescriptions", cache.prescriptions.length],
  ["Doctors", cache.doctors.length],
  [],
  ["Invoice ID","Patient","Date","Status","Amount"],
  ...cache.bills.map(b=>[b.id, getPatient(b.patientId)?.name||"-", b.date, b.status, b.amount])
 ];
 const csv = rows.map(r=>r.map(c=>`"${String(c??"").replace(/"/g,'""')}"`).join(",")).join("\n");
 const blob = new Blob([csv], {type:"text/csv"});
 const a = document.createElement("a");
 a.href = URL.createObjectURL(blob);
 a.download = "al-makkah-report-"+today()+".csv";
 a.click();
 toast("Report exported as CSV.","success");
}

/* =========================================================
   SETTINGS + USERS + BACKUP
   ========================================================= */
function loadSettings(){
 const s = cache.settings;
 document.getElementById("settingClinic").value = s.clinic||"";
 document.getElementById("settingPhone").value = s.phone||"";
 document.getElementById("settingAddress").value = s.address||"";
 document.getElementById("settingCurrency").value = s.currency||"PKR";
 document.getElementById("settingNote").value = s.note||"";
}
async function saveSettings(){
 const s = {
  id: "main",
  clinic: document.getElementById("settingClinic").value.trim() || "Al-Makkah Clinic",
  phone: document.getElementById("settingPhone").value.trim(),
  address: document.getElementById("settingAddress").value.trim(),
  currency: document.getElementById("settingCurrency").value,
  note: document.getElementById("settingNote").value.trim()
 };
 await idbPut("settings", s);
 cache.settings = s;
 toast("Settings saved.","success");
}

function renderUsers(){
 const tbody = document.getElementById("usersTable");
 tbody.innerHTML = cache.users.map(u=>`
  <tr>
   <td>${esc(u.name)}</td>
   <td>${esc(u.username)}</td>
   <td><span class="badge badge-blue">${esc(u.role)}</span></td>
   <td>
    ${u.id===session.id
     ? '<span class="badge badge-gray">You</span>'
     : `<button class="btn btn-danger btn-sm" onclick="deleteUser('${u.id}')">Delete</button>`}
   </td>
  </tr>`).join("") || `<tr><td colspan="4" class="empty">No users</td></tr>`;
}
function openUserModal(){
 openModal("Add User", `
  <div class="form-grid">
   <div class="full"><label>Full Name</label><input id="uName"></div>
   <div><label>Username</label><input id="uUser"></div>
   <div><label>Password</label><input id="uPass" type="password" minlength="6"></div>
   <div class="full"><label>Role</label><select id="uRole"><option value="admin">Administrator</option><option value="doctor">Doctor</option><option value="receptionist">Receptionist</option></select></div>
  </div>
 `, async ()=>{
  const name = document.getElementById("uName").value.trim();
  const username = document.getElementById("uUser").value.trim();
  const pass = document.getElementById("uPass").value;
  const role = document.getElementById("uRole").value;
  if(!name||!username||!pass){ toast("All fields required.","error"); return; }
  if(pass.length<6){ toast("Password min 6 chars.","error"); return; }
  if(cache.users.some(u=>u.username.toLowerCase()===username.toLowerCase())){ toast("Username taken.","error"); return; }
  const user = { id:uid("u"), name, username, password:hash(pass), role, createdAt:new Date().toISOString() };
  await idbPut("users", user);
  cache.users.push(user);
  renderUsers();
  toast("User added.","success");
  closeModal();
 });
}
async function deleteUser(id){
 if(!confirm("Delete this user?")) return;
 await idbDelete("users", id);
 await reloadStore("users");
 renderUsers();
 toast("User deleted.","success");
}

async function exportBackup(){
 const backup = { exportedAt:new Date().toISOString(), version:DB_VERSION };
 for(const s of ["patients","doctors","appointments","prescriptions","bills","users"]){
  backup[s] = await idbGetAll(s);
 }
 backup.settings = await idbGetAll("settings");
 const blob = new Blob([JSON.stringify(backup,null,2)],{type:"application/json"});
 const a = document.createElement("a");
 a.href = URL.createObjectURL(blob);
 a.download = "al-makkah-backup-"+today()+".json";
 a.click();
 toast("Backup downloaded.","success");
}
async function importBackup(e){
 const file = e.target.files[0]; if(!file) return;
 if(!confirm("Importing will REPLACE all current data. Continue?")) { e.target.value=""; return; }
 try{
  const text = await file.text();
  const b = JSON.parse(text);
  for(const s of ["patients","doctors","appointments","prescriptions","bills","users"]){
   if(b[s]) for(const item of b[s]) await idbPut(s, item);
  }
  if(b.settings) for(const item of b.settings) await idbPut("settings", item);
  await loadAllFromDB();
  updateAll();
  renderUsers();
  loadSettings();
  toast("Backup restored successfully.","success");
 }catch(err){
  toast("Invalid backup file.","error");
 }
 e.target.value = "";
}
async function clearAllData(){
 if(!confirm("This will DELETE ALL clinic data permanently. Are you sure?")) return;
 if(!confirm("Final confirmation — this cannot be undone. Delete everything?")) return;
 for(const s of ["patients","doctors","appointments","prescriptions","bills"]){
  await idbClear(s);
 }
 await seedIfEmpty();
 await loadAllFromDB();
 updateAll();
 toast("All data cleared.","success");
}

/* =========================================================
   RELOAD HELPERS
   ========================================================= */
async function reloadStore(name){
 cache[name] = await idbGetAll(name);
 updateAll();
}

function updateAll(){
 renderPatients();
 renderDoctors();
 renderAppointments();
 renderPrescriptions();
 renderBills();
 updateDashboard();
 updateReports();
}

/* =========================================================
   INIT
   ========================================================= */
(async function init(){
 try{
  await openDB();
  await seedIfEmpty();
  await loadAllFromDB();
  loadSettings();

  // Restore session
  const savedSession = sessionStorage.getItem("almakkah_session");
  if(savedSession){
   try{
    const s = JSON.parse(savedSession);
    const u = cache.users.find(x=>x.id===s.id);
    if(u){ session = s; enterApp(); return; }
   }catch(e){}
  }
  // Show login
  document.getElementById("loginScreen").style.display = "flex";
  document.getElementById("app").style.display = "none";
 }catch(err){
  console.error(err);
  alert("Database initialization failed: " + err.message);
 }
})();

