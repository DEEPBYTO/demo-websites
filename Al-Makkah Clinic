function updateReports(){
 const from = document.getElementById("reportFrom").value;
 const to = document.getElementById("reportTo").value;
 const inRange = d => (!from || d >= from) && (!to || d <= to);

 const appts = cache.appointments.filter(a=>inRange(a.date||""));
 const rxs = cache.prescriptions.filter(r=>inRange(r.date||""));
 const bills = cache.bills.filter(b=>inRange(b.date||""));
 const patients = cache.patients; // total always

 const revenue = bills.filter(b=>b.status==="Paid").reduce((s,b)=>s+Number(b.amount||0),0);
 const pending = bills.filter(b=>b.status==="Pending").reduce((s,b)=>s+Number(b.amount||0),0);

 document.getElementById("reportPatients").textContent = patients.length;
 document.getElementById("reportAppointments").textContent = appts.length;
 document.getElementById("reportPrescriptions").textContent = rxs.length;
 document.getElementById("reportRevenue").textContent = fmtMoney(revenue);

 // breakdown
 const statuses = ["Scheduled","Waiting","Completed","Cancelled"];
 const counts = statuses.map(s=>({s, c:appts.filter(a=>a.status===s).length}));
 const max = Math.max(1, ...counts.map(x=>x.c));
 document.getElementById("reportApptBreakdown").innerHTML = counts.map(x=>`
  <div style="margin-bottom:10px">
   <div style="display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:4px"><span>${x.s}</span><strong>${x.c}</strong></div>
   <div style="height:7px;background:#f1f5f9;border-radius:4px;overflow:hidden">
    <div style="height:100%;width:${(x.c/max*100).toFixed(1)}%;background:var(--primary)"></div>
   </div>
  </div>`).join("") || `<div class="empty">No data</div>`;

 document.getElementById("reportRevBreakdown").innerHTML = `
  <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)"><span>Paid Revenue</span><strong style="color:var(--success)">${cur()} ${fmtMoney(revenue)}</strong></div>
