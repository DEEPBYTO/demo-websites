/* ---------- HASH (simple, non-crypto; for demo security) ---------- */
function hash(str){
 // Simple hash for demo. In production use bcrypt on server.
 let h = 0;
 for(let i=0;i<str.length;i++){ h = ((h<<5)-h) + str.charCodeAt(i); h |= 0; }
 return "h" + Math.abs(h).toString(36);
}

/* ---------- UTIL ---------- */
function uid(prefix){ return prefix + "-" + Date.now().toString(36) + Math.random().toString(36).slice(2,5); }
function today(){ return new Date().toISOString().split("T")[0]; }
function fmtMoney(v){ return Number(v||0).toLocaleString("en-PK"); }
function esc(v){ return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;"); }
function getPatient(id){ return cache.patients.find(p=>p.id===id); }
function getDoctor(id){ return cache.doctors.find(d=>d.id===id); }
function getUser(id){ return cache.users.find(u=>u.id===id); }

function toast(msg, type="info"){
 const el = document.createElement("div");
 el.className = "toast " + type;
 el.textContent = msg;
 document.getElementById("toast").appendChild(el);
 setTimeout(()=>{ el.style.opacity="0"; el.style.transition="opacity .3s"; setTimeout(()=>el.remove(),300); }, 3000);
}

