<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Al-Makkah Clinic — Management System</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
 --primary:#0f766e;--primary2:#115e59;--primary-light:#ccfbf1;
 --bg:#f1f5f9;--card:#fff;--text:#0f172a;--muted:#64748b;
 --border:#e2e8f0;--danger:#dc2626;--danger-bg:#fee2e2;
 --warning:#d97706;--warning-bg:#fef3c7;--success:#16a34a;--success-bg:#dcfce7;
 --info:#2563eb;--info-bg:#dbeafe;
 --sidebar:#0b1720;--radius:10px;--shadow:0 1px 3px rgba(0,0,0,.06);
}
html,body{height:100%}
body{font-family:'Segoe UI',Inter,system-ui,Arial,sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
.hidden{display:none!important}
input,select,textarea{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:8px;background:#fff;outline:none;transition:.15s}
input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(15,118,110,.12)}
input[disabled],textarea[disabled]{background:#f8fafc;color:#64748b;cursor:not-allowed}
label{display:block;font-size:12px;font-weight:600;margin-bottom:5px;color:#334155}

/* LOGIN */
#loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:linear-gradient(135deg,#042f2e 0%,#0f766e 100%)}
.login-box{width:100%;max-width:440px;background:#fff;border-radius:16px;padding:36px;box-shadow:0 25px 70px rgba(0,0,0,.35)}
.logo{width:68px;height:68px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;margin-bottom:20px}
.login-box h1{font-size:24px;margin-bottom:6px}
.login-box .sub{color:var(--muted);margin-bottom:24px;font-size:13px}
.login-error{background:#fee2e2;color:#991b1b;padding:11px 13px;border-radius:8px;font-size:13px;margin-bottom:16px;border-left:3px solid #dc2626}
.login-btn{width:100%;background:var(--primary);color:#fff;padding:12px;border-radius:9px;font-weight:700;font-size:14px;transition:.15s}
.login-btn:hover{background:var(--primary2)}
.login-btn:disabled{opacity:.6;cursor:not-allowed}
.demo-hint{margin-top:16px;padding:11px;background:#f0fdfa;border:1px solid #99f6e4;border-radius:8px;font-size:12px;color:#115e59;text-align:center}
.tabs{display:flex;gap:6px;margin-bottom:20px;background:#f1f5f9;padding:4px;border-radius:8px}
.tabs button{flex:1;padding:8px;border-radius:6px;font-size:13px;font-weight:600;color:var(--muted)}
.tabs button.active{background:#fff;color:var(--primary);box-shadow:var(--shadow)}

/* APP */
#app{display:none;min-height:100vh}
.sidebar{width:250px;position:fixed;left:0;top:0;bottom:0;background:var(--sidebar);color:#fff;padding:18px 12px;z-index:20;overflow-y:auto}
.brand{padding:8px 10px 20px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.brand .b-logo{width:38px;height:38px;border-radius:10px;background:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px}
.brand strong{font-size:15px;display:block;line-height:1.2}
.brand span{display:block;color:#94a3b8;font-size:11px;margin-top:2px}
.nav-section{font-size:10px;text-transform:uppercase;color:#64748b;padding:12px 12px 6px;letter-spacing:.5px;font-weight:700}
.nav-item{width:100%;display:flex;align-items:center;gap:11px;padding:10px 12px;color:#cbd5e1;border-radius:7px;margin-bottom:2px;text-align:left;font-size:13.5px;transition:.12s}
.nav-item:hover{background:rgba(255,255,255,.05);color:#fff}
.nav-item.active{background:var(--primary);color:#fff;font-weight:600}
.nav-icon{width:18px;text-align:center;font-size:15px}
.logout{margin-top:14px;color:#fca5a5}
.logout:hover{background:#7f1d1d;color:#fff}
.main{margin-left:250px;min-height:100vh;display:flex;flex-direction:column}
.topbar{height:64px;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:10}
.topbar h2{font-size:17px;font-weight:700}
.topbar .sub{font-size:12px;color:var(--muted);margin-top:1px}
.user{display:flex;align-items:center;gap:10px;font-size:13px}
.user .name{font-weight:600}
.user .role{font-size:11px;color:var(--muted)}
.avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#14b8a6,#0f766e);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
.content{padding:24px;flex:1}
.page{display:none;animation:fadeIn .2s}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.page-title{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px;flex-wrap:wrap}
.page-title h1{font-size:21px;font-weight:700}
.page-title p{font-size:12.5px;color:var(--muted);margin-top:2px}

/* BUTTONS */
.btn{border-radius:8px;padding:9px 14px;font-size:13px;font-weight:600;transition:.15s;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover:not(:disabled){background:var(--primary2)}
.btn-secondary{background:#e2e8f0;color:#334155}
.btn-secondary:hover:not(:disabled){background:#cbd5e1}
.btn-danger{background:var(--danger-bg);color:#991b1b}
.btn-danger:hover:not(:disabled){background:#fecaca}
.btn-success{background:var(--success-bg);color:#166534}
.btn-outline{background:#fff;border:1px solid var(--border);color:#334155}
.btn-outline:hover{background:#f8fafc}
.btn-sm{padding:6px 10px;font-size:12px}

/* CARDS */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12.5px;font-weight:500}
.stat-value{font-size:26px;font-weight:800;margin-top:8px;color:var(--text)}
.stat-icon{width:36px;height:36px;border-radius:9px;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:16px}
.stat.green .stat-icon{background:#dcfce7;color:#16a34a}
.stat.blue .stat-icon{background:#dbeafe;color:#2563eb}
.stat.amber .stat-icon{background:#fef3c7;color:#d97706}
.grid-2{display:grid;grid-template-columns:1.5fr 1fr;gap:16px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.card-head h3{font-size:14.5px;font-weight:700}
.card-body{padding:18px}
.card-body.no-pad{padding:0}

/* TABLES */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th,td{padding:11px 14px;border-bottom:1px solid var(--border);text-align:left;font-size:13px;white-space:nowrap;vertical-align:middle}
th{background:#f8fafc;color:#475569;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:.4px}
tbody tr:hover{background:#f8fafc}
tbody tr:last-child td{border-bottom:0}
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;line-height:1.5}
.badge-green{background:var(--success-bg);color:#166534}
.badge-yellow{background:var(--warning-bg);color:#92400e}
.badge-red{background:var(--danger-bg);color:#991b1b}
.badge-blue{background:var(--info-bg);color:#1e40af}
.badge-gray{background:#f1f5f9;color:#475569}
.actions{display:flex;gap:5px}
.empty{padding:40px 20px;text-align:center;color:var(--muted);font-size:13.5px}
.empty-icon{font-size:38px;margin-bottom:8px;opacity:.4}

/* TOOLBAR */
.toolbar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center}
.search{flex:1;min-width:220px;position:relative}
.search input{padding-left:34px}
.search::before{content:"🔍";position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:13px;opacity:.5}
.filter-select{min-width:150px;width:auto}

/* FORMS */
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.form-grid .full{grid-column:1/-1}
.form-grid .third{grid-column:span 1}
.section-title{grid-column:1/-1;font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.5px;margin-top:8px;padding-bottom:6px;border-bottom:1px solid var(--border)}

/* MODAL */
.modal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:100;backdrop-filter:blur(2px)}
.modal.show{display:flex}
.modal-box{width:100%;max-width:680px;max-height:92vh;overflow:auto;background:#fff;border-radius:14px;box-shadow:0 25px 70px rgba(0,0,0,.35);display:flex;flex-direction:column}
.modal-box.wide{max-width:900px}
.modal-head{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:#fff;z-index:1;border-radius:14px 14px 0 0}
.modal-head h3{font-size:16px;font-weight:700}
.close{width:32px;height:32px;border-radius:8px;font-size:20px;color:#64748b;display:flex;align-items:center;justify-content:center}
.close:hover{background:#f1f5f9;color:#0f172a}
.modal-body{padding:22px;flex:1}
.modal-foot{padding:14px 22px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;position:sticky;bottom:0;background:#fff;border-radius:0 0 14px 14px}

/* TOAST */
#toast{position:fixed;top:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px}
.toast{background:#0f172a;color:#fff;padding:12px 16px;border-radius:9px;font-size:13px;font-weight:500;box-shadow:0 10px 30px rgba(0,0,0,.25);animation:slideIn .25s;display:flex;align-items:center;gap:10px;min-width:250px;max-width:400px}
.toast.success{background:#065f46;border-left:3px solid #10b981}
.toast.error{background:#7f1d1d;border-left:3px solid #ef4444}
.toast.info{background:#1e3a8a;border-left:3px solid #3b82f6}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

/* WELCOME */
.welcome{background:linear-gradient(135deg,#0f766e,#134e4a);color:#fff;border-radius:var(--radius);padding:22px 24px;margin-bottom:18px;position:relative;overflow:hidden}
.welcome::after{content:"";position:absolute;right:-30px;top:-30px;width:150px;height:150px;background:rgba(255,255,255,.06);border-radius:50%}
.welcome h2{font-size:19px;margin-bottom:5px}
.welcome p{color:#a7f3d0;font-size:13px}

/* PRINT */
@media print{
 .sidebar,.topbar,.page-title button,.no-print{display:none!important}
 .main{margin-left:0}
 .content{padding:0}
 .modal{position:static;background:#fff;padding:0}
 .modal-box{box-shadow:none;max-width:100%}
 .modal-foot,.modal-head .close{display:none}
}

/* RESPONSIVE */
.mobile-menu{display:none;font-size:20px;padding:6px 10px;border-radius:6px}
.mobile-menu:hover{background:#f1f5f9}
@media(max-width:1100px){
 .stats{grid-template-columns:repeat(2,1fr)}
 .grid-2,.grid-3{grid-template-columns:1fr}
}
@media(max-width:768px){
 .sidebar{transform:translateX(-100%);transition:.25s}
 .sidebar.open{transform:translateX(0)}
 .main{margin-left:0}
 .mobile-menu{display:block}
 .topbar{padding:0 14px}
 .content{padding:14px}
 .form-grid{grid-template-columns:1fr}
 .stats{grid-template-columns:1fr 1fr}
 .page-title h1{font-size:18px}
}
@media(max-width:480px){
 .stats{grid-template-columns:1fr}
 .login-box{padding:24px 20px}
 .modal-box{border-radius:0;max-height:100vh}
}
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<section id="loginScreen">
 <div class="login-box">
  <div class="logo">AM</div>
  <h1>Al-Makkah Clinic</h1>
  <p class="sub">Clinic Management System</p>

  <div class="tabs">
   <button class="active" data-auth-tab="login" onclick="switchAuthTab('login')">Sign In</button>
   <button data-auth-tab="register" onclick="switchAuthTab('register')">Register</button>
  </div>

  <div id="loginError" class="login-error hidden"></div>

  <form id="loginForm" onsubmit="event.preventDefault();doLogin()">
   <div style="margin-bottom:14px">
    <label>Username</label>
    <input id="loginUser" placeholder="Enter username" autocomplete="username" required>
   </div>
   <div style="margin-bottom:18px">
    <label>Password</label>
    <input id="loginPass" type="password" placeholder="Enter password" autocomplete="current-password" required>
   </div>
   <button type="submit" class="login-btn" id="loginBtn">Sign In</button>
  </form>

  <form id="registerForm" class="hidden" onsubmit="event.preventDefault();doRegister()">
   <div style="margin-bottom:14px">
    <label>Full Name</label>
    <input id="regName" placeholder="Dr. Ahmed Khan" required>
   </div>
   <div style="margin-bottom:14px">
    <label>Username</label>
    <input id="regUser" placeholder="Choose username" required>
   </div>
   <div style="margin-bottom:14px">
    <label>Password (min 6 characters)</label>
    <input id="regPass" type="password" minlength="6" required>
   </div>
   <div style="margin-bottom:18px">
    <label>Role</label>
    <select id="regRole">
     <option value="admin">Administrator</option>
     <option value="doctor">Doctor</option>
     <option value="receptionist">Receptionist</option>
    </select>
   </div>
   <button type="submit" class="login-btn">Create Account</button>
  </form>

  <div class="demo-hint">
   <strong>First time?</strong> Register as Administrator.<br>
   Default demo login: <strong>admin / admin123</strong>
  </div>
 </div>
</section>

<!-- ============ APP ============ -->
<div id="app">
 <aside class="sidebar" id="sidebar">
  <div class="brand">
   <div class="b-logo">AM</div>
   <div>
    <strong>Al-Makkah Clinic</strong>
    <span>Management System</span>
   </div>
  </div>

  <div class="nav-section">Main</div>
  <button class="nav-item active" data-page="dashboard"><span class="nav-icon">⌂</span> Dashboard</button>
  <button class="nav-item" data-page="patients"><span class="nav-icon">♙</span> Patients</button>
  <button class="nav-item" data-page="appointments"><span class="nav-icon">▣</span> Appointments</button>
  <button class="nav-item" data-page="doctors"><span class="nav-icon">⚕</span> Doctors</button>

  <div class="nav-section">Clinical</div>
  <button class="nav-item" data-page="prescriptions"><span class="nav-icon">℞</span> Prescriptions</button>
  <button class="nav-item" data-page="billing"><span class="nav-icon">₨</span> Billing</button>

  <div class="nav-section">System</div>
  <button class="nav-item" data-page="reports"><span class="nav-icon">▥</span> Reports</button>
  <button class="nav-item" data-page="settings"><span class="nav-icon">⚙</span> Settings</button>

  <button class="nav-item logout" onclick="doLogout()"><span class="nav-icon">↪</span> Logout</button>
 </aside>

 <main class="main">
  <header class="topbar">
   <div style="display:flex;align-items:center;gap:10px">
    <button class="mobile-menu" onclick="toggleSidebar()">☰</button>
    <div>
     <h2 id="topTitle">Dashboard</h2>
     <div class="sub" id="topSub">Welcome back</div>
    </div>
   </div>
   <div class="user">
    <div style="text-align:right">
     <div class="name" id="userName">Administrator</div>
     <div class="role" id="userRole">Admin</div>
    </div>
    <div class="avatar" id="userAvatar">A</div>
   </div>
  </header>

  <div class="content">

   <!-- DASHBOARD -->
   <section class="page active" id="dashboard">
    <div class="welcome">
     <h2 id="welcomeName">Welcome back, Administrator 👋</h2>
     <p>Here's what's happening at your clinic today.</p>
    </div>

    <div class="stats">
     <div class="stat"><div class="stat-top"><span>Total Patients</span><div class="stat-icon">♙</div></div><div class="stat-value" id="statPatients">0</div></div>
     <div class="stat blue"><div class="stat-top"><span>Today's Appointments</span><div class="stat-icon">▣</div></div><div class="stat-value" id="statAppointments">0</div></div>
     <div class="stat green"><div class="stat-top"><span>Doctors</span><div class="stat-icon">⚕</div></div><div class="stat-value" id="statDoctors">0</div></div>
     <div class="stat amber"><div class="stat-top"><span>Revenue (Paid)</span><div class="stat-icon">₨</div></div><div class="stat-value">₨ <span id="statRevenue">0</span></div></div>
    </div>

    <div class="grid-2">
     <div class="card">
      <div class="card-head"><h3>Recent Patients</h3><button class="btn btn-outline btn-sm" onclick="showPage('patients')">View All</button></div>
      <div class="table-wrap"><table><thead><tr><th>Patient</th><th>Phone</th><th>Gender</th><th>Age</th></tr></thead><tbody id="recentPatients"></tbody></table></div>
     </div>
     <div class="card">
      <div class="card-head"><h3>Today's Appointments</h3><button class="btn btn-outline btn-sm" onclick="showPage('appointments')">View All</button></div>
      <div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Time</th></tr></thead><tbody id="todayAppointments"></tbody></table></div>
     </div>
    </div>
   </section>

   <!-- PATIENTS -->
   <section class="page" id="patients">
    <div class="page-title">
     <div><h1>Patients</h1><p>Manage patient records & medical history</p></div>
     <button class="btn btn-primary" onclick="openPatientModal()">+ Add Patient</button>
    </div>
    <div class="card">
     <div class="card-body">
      <div class="toolbar">
       <div class="search"><input id="patientSearch" placeholder="Search by name, phone, or ID..." oninput="renderPatients()"></div>
       <select id="patientGenderFilter" class="filter-select" onchange="renderPatients()" style="max-width:150px">
        <option value="">All Genders</option><option>Male</option><option>Female</option><option>Other</option>
       </select>
      </div>
     </div>
     <div class="table-wrap">
      <table>
       <thead><tr><th>ID</th><th>Patient</th><th>Phone</th><th>Gender</th><th>Age</th><th>Blood</th><th>Actions</th></tr></thead>
       <tbody id="patientsTable"></tbody>
      </table>
     </div>
    </div>
   </section>

   <!-- APPOINTMENTS -->
   <section class="page" id="appointments">
    <div class="page-title">
     <div><h1>Appointments</h1><p>Schedule & manage patient visits</p></div>
     <button class="btn btn-primary" onclick="openAppointmentModal()">+ New Appointment</button>
    </div>
    <div class="card">
     <div class="card-body">
      <div class="toolbar">
       <input type="date" id="apptDateFilter" class="filter-select" onchange="renderAppointments()">
       <select id="apptStatusFilter" class="filter-select" onchange="renderAppointments()">
        <option value="">All Status</option><option>Scheduled</option><option>Completed</option><option>Cancelled</option><option>Waiting</option>
       </select>
       <button class="btn btn-outline btn-sm" onclick="document.getElementById('apptDateFilter').value='';document.getElementById('apptStatusFilter').value='';renderAppointments()">Clear Filters</button>
      </div>
     </div>
     <div class="table-wrap">
      <table>
       <thead><tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th><th>Actions</th></tr></thead>
       <tbody id="appointmentsTable"></tbody>
      </table>
     </div>
    </div>
   </section>

   <!-- DOCTORS -->
   <section class="page" id="doctors">
    <div class="page-title">
     <div><h1>Doctors</h1><p>Manage clinic doctors & specialists</p></div>
     <button class="btn btn-primary" onclick="openDoctorModal()">+ Add Doctor</button>
    </div>
    <div class="card">
     <div class="table-wrap">
      <table>
       <thead><tr><th>ID</th><th>Doctor</th><th>Specialization</th><th>Phone</th><th>Fee</th><th>Actions</th></tr></thead>
       <tbody id="doctorsTable"></tbody>
      </table>
     </div>
    </div>
   </section>

   <!-- PRESCRIPTIONS -->
   <section class="page" id="prescriptions">
    <div class="page-title">
     <div><h1>Prescriptions</h1><p>Create & manage patient prescriptions</p></div>
     <button class="btn btn-primary" onclick="openPrescriptionModal()">+ New Prescription</button>
    </div>
    <div class="card">
     <div class="table-wrap">
      <table>
       <thead><tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Diagnosis</th><th>Actions</th></tr></thead>
       <tbody id="prescriptionsTable"></tbody>
      </table>
     </div>
    </div>
   </section>

   <!-- BILLING -->
   <section class="page" id="billing">
    <div class="page-title">
     <div><h1>Billing</h1><p>Manage invoices & payments</p></div>
     <button class="btn btn-primary" onclick="openBillModal()">+ Create Invoice</button>
    </div>
    <div class="card">
     <div class="card-body">
      <div class="toolbar">
       <select id="billStatusFilter" class="filter-select" onchange="renderBills()">
        <option value="">All Status</option><option>Paid</option><option>Pending</option>
       </select>
      </div>
     </div>
     <div class="table-wrap">
